# Makefile for Rust TCPing cross-compilation and packaging

# Project configuration
PROJECT_NAME := tcping
VERSION := 1.0.0
TARGET_LINUX := x86_64-unknown-linux-gnu
TARGET_MACOS := x86_64-apple-darwin
BUILD_DIR := target
RELEASE_DIR := releases

# Package configuration
DEB_PACKAGE_NAME := $(PROJECT_NAME)_$(VERSION)_amd64.deb
MACOS_PACKAGE_NAME := $(PROJECT_NAME)_$(VERSION)_macos.tar.gz

# Default target
all: build-linux build-macos

# Build for Linux (Ubuntu)
build-linux:
	@echo "Building for Linux (Ubuntu)..."
	cargo build --release --target $(TARGET_LINUX)
	@echo "Linux build complete"

# Build for macOS
build-macos:
	@echo "Building for macOS..."
	cargo build --release --target $(TARGET_MACOS)
	@echo "macOS build complete"

# Create Ubuntu .deb package
deb-package: build-linux
	@echo "Creating Ubuntu .deb package..."
	mkdir -p $(RELEASE_DIR)/deb/DEBIAN
	mkdir -p $(RELEASE_DIR)/deb/usr/local/bin
	mkdir -p $(RELEASE_DIR)/deb/usr/share/doc/$(PROJECT_NAME)

	# Copy binary
	cp $(BUILD_DIR)/$(TARGET_LINUX)/release/$(PROJECT_NAME) $(RELEASE_DIR)/deb/usr/local/bin/

	# Create control file
	@echo "Package: $(PROJECT_NAME)" > $(RELEASE_DIR)/deb/DEBIAN/control
	@echo "Version: $(VERSION)" >> $(RELEASE_DIR)/deb/DEBIAN/control
	@echo "Section: net" >> $(RELEASE_DIR)/deb/DEBIAN/control
	@echo "Priority: optional" >> $(RELEASE_DIR)/deb/DEBIAN/control
	@echo "Architecture: amd64" >> $(RELEASE_DIR)/deb/DEBIAN/control
	@echo "Maintainer: TCPing Maintainer <maintainer@example.com>" >> $(RELEASE_DIR)/deb/DEBIAN/control
	@echo "Description: TCP connection testing tool" >> $(RELEASE_DIR)/deb/DEBIAN/control
	@echo " A Rust implementation of TCPing for testing TCP connectivity and measuring RTT." >> $(RELEASE_DIR)/deb/DEBIAN/control

	# Create copyright file
	@echo "TCPing - Copyright $(shell date +%Y)" > $(RELEASE_DIR)/deb/usr/share/doc/$(PROJECT_NAME)/copyright
	@echo "This is free software; see the source for copying conditions." >> $(RELEASE_DIR)/deb/usr/share/doc/$(PROJECT_NAME)/copyright

	# Build the package
	dpkg-deb --build $(RELEASE_DIR)/deb $(RELEASE_DIR)/$(DEB_PACKAGE_NAME)
	@echo "Ubuntu package created: $(RELEASE_DIR)/$(DEB_PACKAGE_NAME)"

# Create macOS .tar.gz package
macos-package: build-macos
	@echo "Creating macOS .tar.gz package..."
	mkdir -p $(RELEASE_DIR)/macos/bin
	mkdir -p $(RELEASE_DIR)/macos/doc

	# Copy binary
	cp $(BUILD_DIR)/$(TARGET_MACOS)/release/$(PROJECT_NAME) $(RELEASE_DIR)/macos/bin/

	# Create README
	@echo "TCPing $(VERSION) for macOS" > $(RELEASE_DIR)/macos/doc/README.txt
	@echo "=============================" >> $(RELEASE_DIR)/macos/doc/README.txt
	@echo "" >> $(RELEASE_DIR)/macos/doc/README.txt
	@echo "Usage: ./tcping <hostname> <port>" >> $(RELEASE_DIR)/macos/doc/README.txt
	@echo "Example: ./tcping 8.8.8.8 53" >> $(RELEASE_DIR)/macos/doc/README.txt

	# Create archive
	cd $(RELEASE_DIR)/macos && tar -czf ../$(MACOS_PACKAGE_NAME) .
	@echo "macOS package created: $(RELEASE_DIR)/$(MACOS_PACKAGE_NAME)"

# Build both packages
packages: deb-package macos-package

# Test Linux package
test-linux: build-linux
	@echo "Testing Linux binary..."
	@$(BUILD_DIR)/$(TARGET_LINUX)/release/$(PROJECT_NAME) --help > /dev/null && echo "✓ Linux binary test passed" || echo "✗ Linux binary test failed"

# Test macOS package
test-macos: build-macos
	@echo "Testing macOS binary..."
	@$(BUILD_DIR)/$(TARGET_MACOS)/release/$(PROJECT_NAME) --help > /dev/null && echo "✓ macOS binary test passed" || echo "✗ macOS binary test failed"

# Test both packages
test: test-linux test-macos

# Clean build artifacts
clean:
	cargo clean
	rm -rf $(RELEASE_DIR)

# Show help
help:
	@echo "Available targets:"
	@echo "  all          - Build for both Linux and macOS"
	@echo "  build-linux  - Build for Linux (Ubuntu)"
	@echo "  build-macos  - Build for macOS"
	@echo "  deb-package  - Create Ubuntu .deb package"
	@echo "  macos-package - Create macOS .tar.gz package"
	@echo "  packages     - Create both packages"
	@echo "  test-linux   - Test Linux binary"
	@echo "  test-macos   - Test macOS binary"
	@echo "  test         - Test both binaries"
	@echo "  clean        - Clean build artifacts"

.PHONY: all build-linux build-macos deb-package macos-package packages test-linux test-macos test clean help